# ---------------------------------------------------------------------------
# MiniBiz environment variables
# Copy to `.env` and fill in the real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string (SRS NFR: PostgreSQL 14+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minibiz?schema=public"

# Secret used by better-auth to sign sessions.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Public URL of the running app. Must match the domain in production,
# otherwise better-auth rejects cross-origin session cookies.
BETTER_AUTH_URL="http://localhost:3000"
